LeanPaper.PullbackReflection.rationalValue_pullback (k : ℕ) (R : Zetahyperbolic.RatMomentElem) (x : ℚ)
  (hAvoid : ∀ j ∈ Finset.Icc 1 R.maxPole, x ≠ ↑j ∧ x ≠ -↑j) :
  x ^ (2 * k + 1) * LeanPaper.PullbackReflection.rationalValue R (-x ^ 2) =
    LeanPaper.PullbackReflection.pulledValue k R x
LeanPaper.PullbackReflection.muFunctionalPoly_eq_pulledMoment (k : ℕ) (hk : 1 ≤ k) (R : Zetahyperbolic.RatMomentElem) :
  Zetahyperbolic.muFunctionalPoly k R = LeanPaper.PullbackReflection.pulledMoment k R
LeanPaper.PullbackReflection.finite_span_reflection (k : ℕ) (hk : 1 ≤ k) (es : Finset ℕ) (u : ℕ → ℚ) (rs : Finset ℤ)
  (v : ℤ → ℚ) :
  LeanPaper.PullbackReflection.reflectedMoment k es u rs v = -LeanPaper.PullbackReflection.tauFiniteSpan k es u rs v
LeanPaper.PullbackReflection.finite_pole_difference (k : ℕ) (rs : Finset ℤ) (v : ℤ → ℚ) (hr : ∀ r ∈ rs, r ≠ 0 ∧ r ≠ 1) :
  ∑ r ∈ rs, Polynomial.C (v r) * (Zetahyperbolic.tauPolePoly k (r - 1) - Zetahyperbolic.tauPolePoly k r) =
    ∑ r ∈ rs, Polynomial.C (v r * -(↑r ^ (2 * k + 1))⁻¹)
