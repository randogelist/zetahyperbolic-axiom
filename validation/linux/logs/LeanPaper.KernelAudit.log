PaperAdvances.Theorem3_8_ExactTaylor.unit_det_linear_coeff {n : ℕ} (A : Matrix (Fin n) (Fin n) ℝ) :
  (PaperAdvances.Theorem3_8_Jacobi.unitDetPoly A).coeff 1 = A.trace
PaperAdvances.Theorem3_8_ExactTaylor.affine_det_exact_second_order {n : ℕ} (G H : Matrix (Fin n) (Fin n) ℝ)
  (hG : G.det ≠ 0) (t : ℝ) :
  (G + t • H).det =
    G.det *
      (1 + (G⁻¹ * H).trace * t +
        Polynomial.eval t (PaperAdvances.Theorem3_8_Jacobi.unitDetPoly (G⁻¹ * H)).divX.divX * t ^ 2)
PaperAdvances.Theorem3_8_Jacobi.unitDetPoly_derivative {n : ℕ} (A : Matrix (Fin n) (Fin n) ℝ) :
  Polynomial.eval 0 (Polynomial.derivative (PaperAdvances.Theorem3_8_Jacobi.unitDetPoly A)) = A.trace
PaperAdvances.Theorem3_8_Jacobi.unitDetPoly_eval {n : ℕ} (A : Matrix (Fin n) (Fin n) ℝ) (t : ℝ) :
  Polynomial.eval t (PaperAdvances.Theorem3_8_Jacobi.unitDetPoly A) = (1 + t • A).det
PaperAdvances.Theorem3_8_Jacobi.unitDet_hasDerivAt {n : ℕ} (A : Matrix (Fin n) (Fin n) ℝ) :
  HasDerivAt (fun t => (1 + t • A).det) A.trace 0
PaperAdvances.Theorem3_8_Jacobi.affineDet_factor_pointwise {n : ℕ} (G H : Matrix (Fin n) (Fin n) ℝ) (hG : G.det ≠ 0)
  (t : ℝ) : (G + t • H).det = G.det * (1 + t • (G⁻¹ * H)).det
PaperAdvances.Theorem3_8_Jacobi.affineDet_hasDerivAt {n : ℕ} (G H : Matrix (Fin n) (Fin n) ℝ) (hG : G.det ≠ 0) :
  HasDerivAt (fun t => (G + t • H).det) (G.det * (G⁻¹ * H).trace) 0
PaperAdvances.Theorem3_8_Jacobi.affineDet_log_hasDerivAt {n : ℕ} (G H : Matrix (Fin n) (Fin n) ℝ) (hG : 0 < G.det) :
  HasDerivAt (fun t => Real.log (G + t • H).det) (G⁻¹ * H).trace 0
