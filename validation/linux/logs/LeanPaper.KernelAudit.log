  (hu : ∀ (i : Fin h), 0 ≤ u i) (j : Fin h) (hj : ∀ (i : Fin h), u i ≤ u j) (r : ℕ) :
  u j ^ r ≤ ∑ i, u i ^ r ∧ ∑ i, u i ^ r ≤ ↑h * u j ^ r
PaperAdvances.Corollary3_6_PowerSumExtrema.even_atomic_moment_bounds {h : ℕ} (u : Fin h → ℝ)
  (hu : ∀ (i : Fin h), 0 ≤ u i) (j : Fin h) (hj : ∀ (i : Fin h), u i ≤ u j) (r : ℕ) :
